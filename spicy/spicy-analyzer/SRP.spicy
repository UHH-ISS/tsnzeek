# -----------------------------------------------------------
#
#  srp.spicy --- IEEE 802.1Qcc Enhancements to SRP support for Spicy
#
# This file adds the grammar for the TalkerEnhanced_FirstValue message 
# and for the ListenerEnhanced_FirstValue message.
#
# (C) 2022 Robin Schenderlein, Hamburg, Germany
# (C) 2026 Doganalp Ergenc, written with the assistance of Claude
# Released under GNU Public License (GPL)
# email robin.schenderlein@studium.uni-hamburg.de
# -----------------------------------------------------------

module SRP;

import spicy;

# The first octet of an SRP frame is the type of its first TLV; it is only inspected here, each
# message unit parses its own TLV header.
public type SRPFrame = unit {
	var tlvType: uint64;

	on %init { self.tlvType = *self.input(); }

	switch ( self.tlvType ) {
		1   -> talkerEnhanced_FirstValue:    TalkerEnhanced_FirstValue;
		15  -> listenerEnhanced_FirstValue:  ListenerEnhanced_FirstValue;
		*   -> unknownMessage:               UnknownMessage;
	};
};

# A first TLV that is neither Talker (1) nor Listener (15); surfaced so that it can be reported.
type UnknownMessage = unit {
	tlvType: uint8;
	: bytes &eod;
};

type TalkerEnhanced_FirstValue = unit {
	: uint8(1);
	talkerLen:  uint8;
	talker:     Talker &size=self.talkerLen;
	status:     Status;
};

type ListenerEnhanced_FirstValue = unit {
	: uint8(15);
	listenerLen:  uint8;
	listener:     Listener &size=self.listenerLen;
	status:       Status;
};

# The bodies are lists of type-length-value items. Which items are mandatory, their order and
# their multiplicity are checked by the Zeek scripts, so that malformed but parsable frames stay visible.
type Talker = unit {
	items:  Item[] &eod;
};

type Listener = unit {
	items:  Item[] &eod;
};

type Item = unit {
	tlvType:  uint8;
	len:      uint8;
	switch ( self.tlvType ) {
		2   -> streamID:                   StreamID                   &size=self.len;
		3   -> streamRank:                 StreamRank                 &size=self.len;
		4   -> endStationInterfaces:       InterfaceID[]              &size=self.len;
		6   -> dataFrameSpecification:     DataFrameItem[]            &size=self.len;
		11  -> trafficSpecification:       TrafficSpecification       &size=self.len;
		12  -> tSpecTimeAware:             TSpecTimeAware             &size=self.len;
		13  -> userToNetworkRequirements:  UserToNetworkRequirements  &size=self.len;
		14  -> interfaceCapabilities:      InterfaceCapabilities      &size=self.len;
		*   -> unknown:                    bytes                      &size=self.len;
	};
};

type StreamID = unit {
	macAddress:  bytes &size=6;
	uniqueID:    uint16;
};

type StreamRank = unit {
	streamRank: bitfield(8) {
		reserved:  1..7;
		rank:      0;
	};
};

# A complete TLV (type 5): used in lists of interfaces.
type InterfaceID = unit {
	: uint8(5);
	len:            uint8 &requires=($$ >= 6);
	macAddress:     bytes &size=6;
	interfaceName:  bytes &size=self.len - 6;
};

type DataFrameItem = unit {
	tlvType:  uint8;
	len:      uint8;
	switch ( self.tlvType ) {
		7   -> ieee802MacAddresses:  IEEE802MacAddresses  &size=self.len;
		8   -> ieee802VlanTag:       IEEE802VlanTag       &size=self.len;
		9   -> ipv4Tuple:            IPv4Tuple            &size=self.len;
		10  -> ipv6Tuple:            IPv6Tuple            &size=self.len;
		*   -> unknown:              bytes                &size=self.len;
	};
};

type IEEE802MacAddresses = unit {
	destinationMacAddress:  bytes &size=6;
	sourceMacAddress:       bytes &size=6;
};

type IEEE802VlanTag = unit {
	priorityCodePoint:  uint8;
	vlanId:             uint16;
};

type IPv4Tuple = unit {
	sourceIpAddress:       addr &ipv4;
	destinationIpAddress:  addr &ipv4;
	dscp:                  uint8;
	protocol:              uint16;
	sourcePort:            uint16;
	destinationPort:       uint16;
};

type IPv6Tuple = unit {
	sourceIpAddress:       addr &ipv6;
	destinationIpAddress:  addr &ipv6;
	dscp:                  uint8;
	protocol:              uint16;
	sourcePort:            uint16;
	destinationPort:       uint16;
};

type TrafficSpecification = unit {
	intervalNumerator:      uint32;
	intervalDenominator:    uint32;
	maxFramesPerInterval:   uint16;
	maxFrameSize:           uint16;
	transmissionSelection:  uint8;
};

type TSpecTimeAware = unit {
	earliestTransmitOffset:  uint32;
	latestTransmitOffset:    uint32;
	jitter:                  uint32;
};

type UserToNetworkRequirements = unit {
	numSeamlessTrees:  uint8;
	maxLatency:        uint32;
};

type InterfaceCapabilities = unit {
	vlan: bitfield(8) {
		reserved:        1..7;
		vlanTagCapable:  0;
	};
	numITL:                uint8;
	numSTL:                uint8;
	cbStreamIdenTypeList:  uint32[self.numITL];
	cbSequenceTypeList:    uint32[self.numSTL];
};

type Status = unit {
	: uint8(16);
	statusLen:  uint8;
	status:     StatusFields &size=self.statusLen;
};

type StatusFields = unit {
	items:  StatusItem[] &eod;
};

type StatusItem = unit {
	tlvType:  uint8;
	len:      uint8;
	switch ( self.tlvType ) {
		17  -> statusInfo:               StatusInfo           &size=self.len;
		18  -> accumulatedLatency:       AccumulatedLatency   &size=self.len;
		19  -> interfaceConfigurations:  ConfigItem[]         &size=self.len;
		21  -> failedInterfaces:         InterfaceID[]        &size=self.len;
		*   -> unknown:                  bytes                &size=self.len;
	};
};

type StatusInfo = unit {
	talkerStatus:    uint8;
	listenerStatus:  uint8;
	failureCode:     uint8;
};

type AccumulatedLatency = unit {
	accumulatedLatency:  uint32;
};

# The InterfaceConfiguration TLV (19) holds the configuration of several interfaces as a flat item list:
# every InterfaceID (5) starts the configuration of the next interface.
type ConfigItem = unit {
	tlvType:  uint8;
	len:      uint8;
	switch ( self.tlvType ) {
		5   -> interfaceID:           InterfaceIDValue     &size=self.len;
		7   -> ieee802MacAddresses:   IEEE802MacAddresses  &size=self.len;
		8   -> ieee802VlanTag:        IEEE802VlanTag       &size=self.len;
		9   -> ipv4Tuple:             IPv4Tuple            &size=self.len;
		10  -> ipv6Tuple:             IPv6Tuple            &size=self.len;
		20  -> timeAwareOffset:       TimeAwareOffset      &size=self.len;
		*   -> unknown:               bytes                &size=self.len;
	};
};

type InterfaceIDValue = unit {
	macAddress:     bytes &size=6;
	interfaceName:  bytes &eod;
};

type TimeAwareOffset = unit {
	timeAwareOffset:  uint32;
};
