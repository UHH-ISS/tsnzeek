# (C) 2022 Robin Schenderlein, Hamburg, Germany
# Released under GNU Public License (GPL)
# email robin.schenderlein@studium.uni-hamburg.de
#
#
# This file was updated: IEEE Std 1588 and IEEE Std 802.1AS (g)PTP support for Spicy by
#
# (C) 2024 Ahmed Abdulfattah, Berlin, Germany
# (C) 2026 Doganalp Ergenc, written with the assistance of Claude
# Released under GNU Public License (GPL)
# email ahmed.abdulfattah@posteo.de
# -----------------------------------------------------------

packet analyzer spicy::FRER:
	parse with FRER::CBFrame;

packet analyzer spicy::SRP:
	parse with SRP::SRPFrame;

packet analyzer spicy::PTP:
	parse with PTP::PTPFrame;

# PTP over UDP/IPv4 and UDP/IPv6 (IEEE 1588 Annex C and D): event messages on 319, general messages on 320.
protocol analyzer spicy::PTP_UDP over UDP:
	parse with PTP::PTPUDPFrame,
	port 319/udp,
	port 320/udp;

import PTP;
import SRP;
import FRER;
import zeek;

export SRP::Item;
export SRP::StreamID;
export SRP::StreamRank;
export SRP::InterfaceID;
export SRP::DataFrameItem;
export SRP::IEEE802MacAddresses;
export SRP::IEEE802VlanTag;
export SRP::IPv4Tuple;
export SRP::IPv6Tuple;
export SRP::TrafficSpecification;
export SRP::TSpecTimeAware;
export SRP::UserToNetworkRequirements;
export SRP::InterfaceCapabilities;
export SRP::StatusItem;
export SRP::StatusInfo;
export SRP::AccumulatedLatency;
export SRP::ConfigItem;
export SRP::InterfaceIDValue;
export SRP::TimeAwareOffset;
export SRP::StatusFields;
export SRP::TalkerEnhanced_FirstValue;
export SRP::ListenerEnhanced_FirstValue;
export SRP::UnknownMessage;

on SRP::TalkerEnhanced_FirstValue    -> event TSN::talkerEnhanced_FirstValueMsg($packet, self);
on SRP::ListenerEnhanced_FirstValue  -> event TSN::listenerEnhanced_FirstValueMsg($packet, self);
on SRP::UnknownMessage               -> event TSN::srp_unknownMsg($packet, self);

export FRER::CBFrame;

on FRER::CBFrame                     -> event TSN::cb_message($packet, self);

on FRER::CBFrame::%error(msg: string) -> event TSN::parse_error($packet, "FRER", msg);
on SRP::SRPFrame::%error(msg: string) -> event TSN::parse_error($packet, "SRP", msg);
on PTP::PTPFrame::%error(msg: string) -> event TSN::parse_error($packet, "PTP", msg);

export PTP::MessageHeader;
export PTP::PortIdentity;
export PTP::Timestamp;
export PTP::ClockQuality;
export PTP::TLV;
export PTP::ManagementTLV;
export PTP::AnnounceMessage;
export PTP::SyncMessage;
export PTP::DelayReqMessage;
export PTP::FollowUpMessage;
export PTP::DelayRespMessage;
export PTP::PdelayReqMessage;
export PTP::PdelayRespMessage;
export PTP::PdelayRespFollowUpMessage;
export PTP::SignalingMessage;
export PTP::ManagementMessage;
export PTP::UnknownMessage;

on PTP::AnnounceMessage if ( ! self.isUdp )              -> event TSN::ptp_announceMsg($packet, self);
on PTP::SyncMessage if ( ! self.isUdp )                  -> event TSN::ptp_syncMsg($packet, self);
on PTP::DelayReqMessage if ( ! self.isUdp )              -> event TSN::ptp_delayReqMsg($packet, self);
on PTP::FollowUpMessage if ( ! self.isUdp )              -> event TSN::ptp_followUpMsg($packet, self);
on PTP::DelayRespMessage if ( ! self.isUdp )             -> event TSN::ptp_delayRespMsg($packet, self);
on PTP::PdelayReqMessage if ( ! self.isUdp )             -> event TSN::ptp_pdelayReqMsg($packet, self);
on PTP::PdelayRespMessage if ( ! self.isUdp )            -> event TSN::ptp_pdelayRespMsg($packet, self);
on PTP::PdelayRespFollowUpMessage if ( ! self.isUdp )    -> event TSN::ptp_pdelayRespFollowUpMsg($packet, self);
on PTP::SignalingMessage if ( ! self.isUdp )             -> event TSN::ptp_signalingMsg($packet, self);
on PTP::ManagementMessage if ( ! self.isUdp )            -> event TSN::ptp_managementMsg($packet, self);
on PTP::UnknownMessage if ( ! self.isUdp )               -> event TSN::ptp_unknownMsg($packet, self);
on PTP::PTPBody if ( ! self.isUdp )    -> event TSN::ptp_frame($packet, self.messageType, self.declaredLength, self.actualLength);

# PTP over UDP: one event per datagram; the scripts dispatch on the message that was parsed.
export PTP::PTPUDPFrame;
export PTP::PTPBody;

on PTP::PTPBody if ( self.isUdp )      -> event TSN::ptp_udp_frame($conn, $is_orig, self);
on PTP::PTPUDPFrame::%error(msg: string) -> event TSN::parse_error_udp($conn, "PTP", msg);
