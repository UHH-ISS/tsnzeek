# The IDS (Python). It waits for the monitor without a time limit and keeps running when the monitor restarts.
# @TSNZEEK_HOME@ and @ZEEK_PREFIX@ are filled in by deploy/install.sh.
[Unit]
Description=TSNZeek IDS: intrusion detection on the messages of the monitor
Documentation=file:@TSNZEEK_HOME@/ids/README.md
After=tsnzeek-monitor.service
Wants=tsnzeek-monitor.service
PartOf=tsnzeek.target

[Service]
User=tsnzeek
Group=tsnzeek
EnvironmentFile=/etc/tsnzeek/tsnzeek.env
Environment=PYTHONPATH=@ZEEK_PREFIX@/lib/zeek/python
Environment=PYTHONUNBUFFERED=1
Environment=TSNZEEK_ALERT_LOG=/var/log/tsnzeek/alerts.log
# state.json (written by the IDS) and control.json (written by the web interface) live here; /var/lib/tsnzeek
StateDirectory=tsnzeek
Environment=TSNZEEK_CONTROL_DIR=/var/lib/tsnzeek
WorkingDirectory=@TSNZEEK_HOME@
# Thresholds: /etc/tsnzeek/ids.json when it exists, else the defaults of ids/config.py.
ExecStart=/usr/bin/python3 -m ids --service
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/var/log/tsnzeek
Restart=on-failure
RestartSec=5

[Install]
WantedBy=tsnzeek.target
