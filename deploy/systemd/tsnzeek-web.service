# The web interface (optional, see deploy/README.md): 127.0.0.1:8000, reads the state and logs, writes control.json.
# @TSNZEEK_HOME@ is filled in by deploy/install.sh --with-web; Django must be in @TSNZEEK_HOME@/.venv.
[Unit]
Description=TSNZeek web interface
Documentation=file:@TSNZEEK_HOME@/web/README.md
After=tsnzeek-ids.service
PartOf=tsnzeek.target

[Service]
# The IDS runs as tsnzeek and owns /var/lib/tsnzeek (state.json); the web interface writes control.json there.
User=tsnzeek
Group=tsnzeek
Environment=TSNZEEK_CONTROL_DIR=/var/lib/tsnzeek
Environment=TSNZEEK_LOG_DIR=/var/log/tsnzeek
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=@TSNZEEK_HOME@
ExecStart=@TSNZEEK_HOME@/.venv/bin/python web/manage.py runserver --noreload 127.0.0.1:8000
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
StateDirectory=tsnzeek
Restart=on-failure
RestartSec=5

[Install]
WantedBy=tsnzeek.target
